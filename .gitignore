# macOS Finder noise
.DS_Store

# Editor scratch files
.idea/
.vscode/
*.swp
*.swo

# Anything Rails generates that we don't want version-controlled.
log/*
tmp/*
storage/*
vendor/*
.bundle/

# The shipped static-asset copies (we regenerate them in start.sh).
public/assets/

# Local env file — the .env.example is committed, the real .env is not.
.env
.env.*
!.env.example

# Keep the lockfile (Gemfile.lock) and credentials.yml.enc; just don't
# leak secrets via the master.key.
config/master.key
