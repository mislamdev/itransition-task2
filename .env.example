# ----- Stock Chart configuration -----
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit it.

# Finnhub API key.  Get a free one from https://finnhub.io/dashboard
# (60 calls/min on the free tier; includes /search and /quote but
# restricts /stock/candle on free plans).
FINNHUB_API_KEY=your_finnhub_api_key_here

# Set to 1 (or true / yes / on) to serve synthetic OHLC data instead of
# calling Finnhub at all.  A yellow banner across the top of the page
# tells the user when this is active.  Useful for demos.
FINNHUB_DEMO=0

# Network: 0.0.0.0 makes the app reachable from other devices on the
# LAN (e.g., your phone).  Set to 127.0.0.1 for loopback only.
BIND=0.0.0.0
PORT=3000
